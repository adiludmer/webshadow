            "mimeType": "text/html",
            "size": 2420,
            "text": "<div class=\"swiper-slide\">\r\n    <div\r\n            class=\"card-mivzak w-100 h-100 position-relative\"\r\n            id=\"mivzak-{{post_id}}\"\r\n            id-data=\"{{post_id}}\"\r\n            date-data=\"{{data_d_m_y}}\"\r\n    >\r\n        <a href=\"{{url}}\" class=\"d-block h-100\">\r\n            <div class=\"d-block\">\r\n                <strong>{{date}}</strong>\r\n            </div>\r\n            <div class=\"d-flex card-mivzak-title\">\r\n                <p>{{title}}</p>\r\n            </div>\r\n        </a>\r\n\r\n\r\n        <div class=\"card-mivzak-pop w-100 position-absolute {{class}}\" style=\"display: none;\">\r\n            <div class=\"card-mivzak-pop-box w-100\">\r\n                <a href=\"{{url}}\">{{excerpt}}</a>\r\n                <div class=\"d-flex w-100 mt-3 pt-3\">\r\n                    <div class=\"socials-style d-inline-flex\">\r\n                        <div class='d-inline-flex me-3'>\r\n                            <a href=\"https://wa.me/?text={{title}} {{link_share}}?utm_source%3Dwhatsapp%26utm_medium%3Dsocial%26utm_campaign%3Dshare%26utm_term%3Dnewsflash_hp%26utm_content%3D{{post_id}}\" target=\"_blank\" class=\"icon-small s31 icon-small-whatsapp\" data-action=\"share/whatsapp/share\"></a>\r\n                        </div>\r\n                        <div class='d-inline-flex me-3'>\r\n                            <button type=\"button\" class=\"icon-small s31 icon-small-copy\" onclick=\"copyToClipboard(this, '{{link_share}}?utm_source%3Dcopy_link%26utm_medium%3Dsocial%26utm_campaign%3Dshare%26utm_term%3Dnewsflash_hp%26utm_content%3D{{post_id}}')\"></button>\r\n                        </div>\r\n                        <div class='d-inline-flex me-3'>\r\n                            <a href=\"https://twitter.com/intent/tweet?text={{title}}%0a{{link_share}}?utm_source%3Dtwitter%26utm_medium%3Dsocial%26utm_campaign%3Dshare%26utm_term%3Dnewsflash_hp%26utm_content%3D{{post_id}}\" class=\"icon-small s31 icon-small-twitter\" target=\"_blank\"></a>\r\n                        </div>\r\n                        <div class='d-inline-flex me-3'>\r\n                            <a href=\"http://www.facebook.com/sharer.php?u={{link_share}}?utm_source%3Dfacebook%26utm_medium%3Dsocial%26utm_campaign%3Dshare%26utm_term%3Dnewsflash_hp%26utm_content%3D{{post_id}}\" class=\"icon-small s31 icon-small-facebook\" target=\"_blank\"></a>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n\r\n    </div>\r\n</div>\r\n"
          },
