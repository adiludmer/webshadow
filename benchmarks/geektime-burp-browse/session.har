            "mimeType": "text/html",
            "size": 1256,
            "text": "<article class=\"swiper-slide slide-job mb-3 push-job rs_equalHeight\"\r\n         job-id=\"{{id_job}}\" job-title=\"{{title}}\" company-id=\"{{id_company}}\" company-name=\"{{company}}\" city=\"{{city}}\"\r\n         data-hash=\"slide{{num}}\"\r\n>\r\n    <a href=\"http://insider.geektime.co.il/jobs#jid={{id_job}}\" target=\"_blank\" class=\"d-block w-100\">\r\n        <div class=\"row\">\r\n            <div class=\"card_thumb col-3\">\r\n                <img src=\"{{url_logo}}\" alt=\"{{company}}\" />\r\n            </div>\r\n            <div class=\"card_content col-9 ps-4\">\r\n                <h3 class=\"w-100 d-block card__title\">{{title}}</h3>\r\n                <div class=\"w-100 d-block card__company\">{{company}}</div>\r\n                <div class=\"w-100 d-block card__city\">\r\n                    <img src=\"https://insider.geektime.co.il/wp-content/themes/geektime-insider/assets/images/icon-location-gray.svg\" class=\"gray show-only-white\">\r\n                    <img src=\"https://insider.geektime.co.il/wp-content/themes/geektime-insider/assets/images/icon-location-white.svg\" class=\"white show-only-dark\">\r\n                    {{city}}\r\n                </div>\r\n                <div class=\"w-100 d-block card__new\">{{new_job}}</div>\r\n            </div>\r\n        </div>\r\n    </a>\r\n</article>\r\n"
          },
