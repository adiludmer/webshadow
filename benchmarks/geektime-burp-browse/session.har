post type-post status-publish format-standard has-post-thumbnail hentry category-81145 tag-jev tag-typesafe tag-91004 tag-chatgpt\">\r\n\r\n                                \t\t\t\t\t\t\t\t\t<div class=\"col-12\">\r\n\t\t\t\t\t\t\t\t\t\t<h1 class=\"head-title\">בהשראת חתן פרס הנובל הישראלי: המודל החדש של יוצר ChatGPT הפך לוויראלי</h1>\r\n\t\t\t\t\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t\t\t\t\t<div class=\"col-12\">\r\n\t\t\t\t\t\t\t\t\t\t<p class=\"head-sub-title\">\r\n\t\t\t\t\t\t\t\t\t\t\tדיוגו אלמיידה כינה את הצ'אטבוט הפופולרי בעולם \"ברק בבקבוק\", אך הבין שזה לא זה. לאחרונה הציג את Jev, מודל שכבר הפך סופר-פופולרי \t\t\t\t\t\t\t\t\t\t</p>\r\n\t\t\t\t\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t\t\t\t\t<div class=\"col-12 info card_meta d-md-flex mb-4\">\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"card_meta_cats\">\r\n\t\t\t\t\t\t\t\t\t\t\t<a class=\"cat\" href=\"https://www.geektime.co.il/category/%d7%91%d7%99%d7%a0%d7%94-%d7%9e%d7%9c%d7%90%d7%9b%d7%95%d7%aa%d7%99%d7%aa/\"> { AI } </a>\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"author sp\">אושרי אלקסלסי</div>\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"date sp\">3.10.26</div>\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t\t\t\t\t<div class=\"col-12 mt-sm-2 sticky-menu-mobile mb-sm-4\">\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"row\">\r\n\t\t\t\t\t\t\t\t\t\t\t<div\r\n\t\t\t\t\t\t\t\t\t\t\t\tclass=\"col-auto share pe-0 pe-sm-1 ev-single-post\">    <div class=\"row\">\r\n        <div class=\"col-auto pe-0\">\r\n            <a href=\"https://wa.me/?text=בהשראת חתן פרס הנובל הישראלי: המודל החדש של יוצר ChatGPT הפך לוויראלי https%3A%2F%2Fwww.geektime.co.il%2Fjev-is-the-new-ai-buzzword%2F%3Futm_source%3Dwhatsapp%26utm_medium%3Dsocial%26utm_campaign%3Dshare%26utm_term%3Darticle_page%26utm_content%3D592355\" ev-data=\"Whatsapp\" class=\"icon-s icon-s-whatsapp\" target=\"_blank\"\r\n               data-action=\"share/whatsapp/share\"></a>\r\n        </div>\r\n        <div class=\"col-auto p-0\">\r\n      