ia='all' />\n<link rel='stylesheet' id='bootstrap-css' href='https://www.geektime.co.il/wp-content/themes/geektime/assets/vendors/bootstrap/css/bootstrap.rtl.css?ver=7' type='text/css' media='all' />\n<link rel='stylesheet' id='geektime_head-css' href='https://www.geektime.co.il/wp-content/themes/geektime/assets/css/head-load.css?ver=7' type='text/css' media='all' />\n<link rel='stylesheet' id='enlighterjs-css' href='https://www.geektime.co.il/wp-content/plugins/enlighter/cache/enlighterjs.min.css?ver=PMLZSHMaoFJdW4v' type='text/css' media='all' />\n<script type=\"text/javascript\" src=\"https://www.geektime.co.il/wp-includes/js/jquery/jquery.min.js?ver=3.7.1\" id=\"jquery-core-js\"></script>\n<script type=\"text/javascript\" src=\"https://www.geektime.co.il/wp-includes/js/jquery/jquery-migrate.min.js?ver=3.4.1\" id=\"jquery-migrate-js\"></script>\n\t\t\t<style>.cmplz-hidden {\n\t\t\t\t\tdisplay: none !important;\n\t\t\t\t}</style><meta name=\"twitter:title\" content=\"עוד בכיר בצוות הבטיחות של OpenAI פורש עם אזהרה מהמצב\" /><meta name=\"twitter:description\" content=\"השבועות האחרונים מלווים בשיח בלתי פוסק על האטת מהירות הפיתוח של מודלי ה-AI עקב שורה של תקריות, כולל הפריצה ל-Hugging Face ע&quot;י סוכני OpenAI. לצד הקריאות הללו נחשפים עוד ועוד עובדים שעזבו את החברות על רקע טענות לטיפול לקוי בבטיחות של המודלים. עובד חדש כזה נחשף בסוף השבוע, שטוען כי &quot;התרבות ב-OpenAI שבורה&quot;. להתנהל כמו […]\" /><meta name=\"twitter:image\" content=\"https://cdn.geektime.co.il/wp-content/uploads/2026/09/SAM-ALTMAN-OPENAI-DEV-DAY-GEEKTIME.jpg\" /><meta property=\"og:image\" content=\"https://cdn.geektime.co.il/wp-content/uploads/2026/09/SAM-ALTMAN-OPENAI-DEV-DAY-GEEKTIME.jpg\" /><link rel=\"icon\" href=\"https://cdn.geektime.co.il/wp-content/uploads/2022/07/favicon-gt-1657181594-42x42.png\" sizes=\"32x32\" />\n<link rel=\"icon\" href=\"https://cdn.geektime.co.il/wp-content/uploads/2022/07/favicon-gt-1657181594-300x300.png\" sizes=\"192x192\" />\n<link rel=\"apple-touch-icon\" h