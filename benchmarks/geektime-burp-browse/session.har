ecoil\" />\n\t<meta property=\"article:published_time\" content=\"2026-10-04T08:16:36+00:00\" />\n\t<meta property=\"og:image\" content=\"https://cdn.geektime.co.il/wp-content/uploads/2026/09/SAM-ALTMAN-OPENAI-DEV-DAY-GEEKTIME-1024x644.jpg\" />\n\t<meta property=\"og:image:width\" content=\"1024\" />\n\t<meta property=\"og:image:height\" content=\"644\" />\n\t<meta property=\"og:image:type\" content=\"image/jpeg\" />\n\t<meta name=\"author\" content=\"אושרי אלקסלסי\" />\n\t<meta name=\"twitter:card\" content=\"summary_large_image\" />\n\t<meta name=\"twitter:creator\" content=\"@https://twitter.com/OshryAlk\" />\n\t<meta name=\"twitter:site\" content=\"@geektimecoil\" />\n\t<meta name=\"twitter:label1\" content=\"נכתב על יד\" />\n\t<meta name=\"twitter:data1\" content=\"אושרי אלקסלסי\" />\n\t<meta name=\"twitter:label2\" content=\"זמן קריאה מוערך\" />\n\t<meta name=\"twitter:data2\" content=\"3 דקות\" />\n\t<script type=\"application/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https://www.geektime.co.il/former-openai-researcher-says-company-culture-is-broken/#article\",\"isPartOf\":{\"@id\":\"https://www.geektime.co.il/former-openai-researcher-says-company-culture-is-broken/\"},\"author\":{\"name\":\"אושרי אלקסלסי\",\"@id\":\"https://www.geektime.co.il/#/schema/person/991e040ef6a8a022d4ecc7949da550ca\"},\"headline\":\"עוד בכיר בצוות הבטיחות של OpenAI פורש עם אזהרה מהמצב\",\"datePublished\":\"2026-10-04T08:16:36+00:00\",\"mainEntityOfPage\":{\"@id\":\"https://www.geektime.co.il/former-openai-researcher-says-company-culture-is-broken/\"},\"wordCount\":19,\"commentCount\":3,\"publisher\":{\"@id\":\"https://www.geektime.co.il/#organization\"},\"image\":{\"@id\":\"https://www.geektime.co.il/former-openai-researcher-says-company-culture-is-broken/#primaryimage\"},\"thumbnailUrl\":\"https://cdn.geektime.co.il/wp-content/uploads/2026/09/SAM-ALTMAN-OPENAI-DEV-DAY-GEEKTIME.jpg\",\"keywords\":[\"OpenA