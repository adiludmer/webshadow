          data-bs-toggle=\"pill\" role=\"tab\" aria-selected=\"true\"\r\n                                            id=\"pills-nextgen-it-tab\"\r\n                                            data-bs-target=\"#pills-nextgen-it\"\r\n                                            aria-controls=\"pills-nextgen-it\"\r\n                                    >NextGen IT</button>\r\n                                </li>\r\n                                                    </ul>\r\n                        <div class=\"w-100 border-bottom p-0 m-0 d-none d-md-block\"></div>\r\n                        <div class=\"tab-content show-cat-complexes bg-blue\" id=\"pills-tabContent\">\r\n                                                            <div class=\"tab-pane fade h-100  show active\"\r\n                                     id=\"pills-human-resources\" role=\"tabpanel\"\r\n                                     aria-labelledby=\"pills-human-resources-tab\"\r\n                                >\r\n                                    <div class=\"row\">\r\n                                        <div class=\"col-12 col-md-5 info-box\" style='background-image: url(https://cdn.geektime.co.il/wp-content/uploads/2025/05/COV1.jpg);'>\r\n                                            <div class=\"row\">\r\n                                                <div class=\"col-12\"></div>\r\n                                            </div>\r\n                                            <div class=\"row mt-auto\">\r\n                                                <div class=\"col-12\">\r\n                                                    <h4 class=\"title-cat mb-0\">פיתוח קריירה</h4>\r\n                                                </div>\r\n                                                <div class=\"col-10 col-md-12 mb-3\">\r\n                                                    <p class=\"entry\">קבוצת SQLink מאגדת שמונה מהחברות המובילות בישראל, המציעות לארגונים קשת רחבה של פתרונות מתקדמים בעולם ה-IT. בקבוצה מעל ל-2,700 מומחים בתחום המחשוב, תחת החזון של קידום ערכי גיוון תעסוקתי והעצמה כחלק מהגשמת היעדים העסקיים של הקבוצה. </p>\r\n                                                </div>\r\n                                                <div class=\"col-12 d-none d-md-flex\">\r\n                                                    <a href=\"https://www.geektime.co.il/category/human-resources/\" class=\"btn btn-green d-inline\">צפו בתוכן</a>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                        <div class=\"col-12 col-md-7 posts mt-5 mt-md-0\">\r\n                                            <div class=\"row lists-area\" data-location=\"מתחמי תוכן - פיתוח קריירה\" data-listid=\"101883135\">\r\n                                            <article class=\"card card-sponsor ease col-12 position-relative mb-3 mb-md-5 pb-3 px-mx480-0 ev_card\"\r\n         tags=\"83625,83135\" post-id=\"590488\"\r\n         data-financed=\"yes\" data-modify-date=\"14/09/2026\" data-title=\"100 סיבות שבגללן אתם צריכים לעדכן את ה-Design System שלכם\" data-date=\"14/09/2026\" data-author=\"כתב אורח\" data-author-id=\"183\" data-cat=\"פרודקט\"\r\n>\r\n    <a href=\"https://www.geektime.co.il/design-system-for-ai-era/\" class=\"d-block w-100\">\r\n        <div class=\"row\">\r\n            <div class=\"card_thumb col-auto col-md-4 pe-md-4\">\r\n                <img src=\"https://cdn.geektime.co.il/wp-content/uploads/2026/08/dreamstime_m_375360556-385x264.jpg.webp\" loading=\"lazy\" width=\"131\" height=\"100\" alt=\"100 סיבות שבגללן אתם צריכים לעדכן את ה-Design System שלכם\"\r\n                     class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image ev-image\" />\r\n                <div class=\"position-absolute top-0\">\r\n                    <div class=\"cat_in_favorites d-none\"></div>\r\n                </div>\r\n  