gins/wpdiscuz-syntax-highlighter/assets/css/wpd-syntax.css' type='text/css' media='all' />\n<link rel='stylesheet' id='bootstrap-css' href='https://www.geektime.co.il/wp-content/themes/geektime/assets/vendors/bootstrap/css/bootstrap.rtl.css?ver=7' type='text/css' media='all' />\n<link rel='stylesheet' id='geektime_head-css' href='https://www.geektime.co.il/wp-content/themes/geektime/assets/css/head-load.css?ver=7' type='text/css' media='all' />\n<link rel='stylesheet' id='enlighterjs-css' href='https://www.geektime.co.il/wp-content/plugins/enlighter/cache/enlighterjs.min.css?ver=PMLZSHMaoFJdW4v' type='text/css' media='all' />\n<script type=\"text/javascript\" src=\"https://www.geektime.co.il/wp-includes/js/jquery/jquery.min.js?ver=3.7.1\" id=\"jquery-core-js\"></script>\n<script type=\"text/javascript\" src=\"https://www.geektime.co.il/wp-includes/js/jquery/jquery-migrate.min.js?ver=3.4.1\" id=\"jquery-migrate-js\"></script>\n\t\t\t<style>.cmplz-hidden {\n\t\t\t\t\tdisplay: none !important;\n\t\t\t\t}</style><meta name=\"twitter:title\" content=\"בהשראת חתן פרס הנובל הישראלי: המודל החדש של יוצר ChatGPT הפך לוויראלי\" /><meta name=\"twitter:description\" content=\"אנחנו רגילים שמודלי ה-AI שמשמשים אותנו היום מייצרים כמויות של טקסט, קוד, תמונות, וידאו ואפילו מוזיקה – רק תנו להם את הפרומפט הנכון (ומספיק טוקנים כמובן). מודל חדש עושה בדיוק את ההפך, ולא ייצר לכם מילה אחת או הזייה אחת. אז למה הוא בכל זאת הפך ללהיט מאז שהושק? &quot;כלאנו ברק בבקבוק, ועדיין הוא לא […]\" /><meta name=\"twitter:image\" content=\"https://cdn.geektime.co.il/wp-content/uploads/2026/09/Screenshot-2026-09-27-at-13.08.54.jpg\" /><meta property=\"og:image\" content=\"https://cdn.geektime.co.il/wp-content/uploads/2026/09/Screenshot-2026-09-27-at-13.08.54.jpg\" /><link rel=\"icon\" href=\"https://cdn.geektime.co.il/wp-content/uploads/2022/07/favicon-gt-1657181594-42x42.png\" sizes=\"32x32\" />\n<link rel=\"icon\" href=\"https://cdn.geektime.co.il/wp-content/uploads/2022/07/favicon-gt-1657181594-300x300.