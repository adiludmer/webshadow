ime.co.il/wp-content/plugins/wp-accessibility-helper/assets/images/accessibility-48.jpg\"\r\n\t\t\talt=\"נגישות\" class=\"aicon_image\" />\r\n\t</button>\r\n\r\n\r\n\t<div id=\"access_container\" aria-hidden=\"true\">\r\n\t\t<button tabindex=\"-1\" type=\"button\" class=\"close_container wahout\"\r\n\t\t\taccesskey=\"x\"\r\n\t\t\taria-label=\"סגור\"\r\n\t\t\ttitle=\"סגור\">\r\n\t\t\tסגור\t\t</button>\r\n\r\n\t\t<div class=\"access_container_inner\">\r\n\t\t\t<div class=\"a_module wah_font_resize\">\r\n\r\n            <div class=\"a_module_title\">שינוי גודל פונט</div>\r\n\r\n            <div class=\"a_module_exe font_resizer\">\r\n\r\n                <button type=\"button\" class=\"wah-action-button smaller wahout\" title=\"פונט קטן יותר\" aria-label=\"פונט קטן יותר\">A-</button>\r\n\r\n                <button type=\"button\" class=\"wah-action-button larger wahout\" title=\"פונט גדול יותר\" aria-label=\"פונט גדול יותר\">A+</button>\r\n\r\n            </div>\r\n\r\n        </div><div class=\"a_module wah_keyboard_navigation\">\r\n\r\n            <div class=\"a_module_exe\">\r\n\r\n                <button type=\"button\" class=\"wah-action-button wahout wah-call-keyboard-navigation\" aria-label=\"ניווט\" title=\"ניווט\">ניווט</button>\r\n\r\n            </div>\r\n\r\n        </div><div class=\"a_module wah_readable_fonts\">\r\n\r\n            <div class=\"a_module_exe readable_fonts\">\r\n\r\n                <button type=\"button\" class=\"wah-action-button wahout wah-call-readable-fonts\" aria-label=\"פונט קריא\" title=\"פונט קריא\">פונט קריא</button>\r\n\r\n            </div>\r\n\r\n        </div><div class=\"a_module wah_contrast_trigger\">\r\n\r\n                <div class=\"a_module_title\">ניגודיות</div>\r\n\r\n                <div class=\"a_module_exe\">\r\n\r\n                    <button type=\"button\" id=\"contrast_trigger\" class=\"contrast_trigger wah-action-button wahout wah-call-contrast-trigger\" title=\"Contrast\">בחירת צבע</button>\r\n\r\n                    <div class=\"color_selector\" aria-hidden=\"true\">\r\n\r\n                        <button type=\"button\" class=\"convar black wahout\" data-bgcolor=\"#000\" data-color=\"#FFF\" title=\"שחור\">שחור</button>\r\n\r\n                        <button type=\"button\" class=\"convar white wahout\" data-bgcolor=\"#FFF\" data-color=\"#000\" title=\"לבן\">לבן</button>\r\n\r\n                        <button type=\"button\" class=\"convar green wahout\" data-bgcolor=\"#00FF21\" data-color=\"#000\" title=\"ירוק\">ירוק</button>\r\n\r\n                        <button type=\"button\" class=\"convar blue wahout\" data-bgcolor=\"#0FF\" data-color=\"#000\" title=\"כחול\">כחול</button>\r\n\r\n                        <button type=\"button\" class=\"convar red wahout\" data-bgcolor=\"#F00\" data-color=\"#000\" title=\"אדום\">אדום</button>\r\n\r\n                        <button type=\"button\" class=\"convar orange wahout\" data-bgcolor=\"#FF6A00\" data-color=\"#000\" title=\"כתום\">כתום</button>\r\n\r\n                        <button type=\"button\" class=\"convar yellow wahout\" data-bgcolor=\"#FFD800\" data-color=\"#000\" title=\"צהוב\">צהוב</button>\r\n\r\n                        <button type=\"button\" class=\"convar navi wahout\" data-bgcolor=\"#B200FF\" data-color=\"#000\" title=\"נאבי\">נאבי</button>\r\n\r\n                    </div>\r\n\r\n                </div>\r\n\r\n            </div><div class=\"a_module wah_underline_links\">\r\n\r\n            <div class=\"a_module_exe\">\r\n\r\n                <button type=\"button\" class=\"wah-action-button wahout wah-call-underline-links\" aria-label=\"סימון קישורים\" title=\"סימון קישורים\">סימון קישורים</button>\r\n\r\n            </div>\r\n\r\n        </div><div class=\"a_module wah_highlight_links\">\r\n\r\n            <div class=\"a_module_exe\">\r\n\r\n                <button type=\"button\" class=\"wah-action-button wahout wah-call-highlight-links\" aria-label=\"סמן קישורים עם צבע רקע\" title=\"סמן קישורים עם צבע רקע\">סמן קישורים עם צבע רקע</button>\r\n\r\n            </div>\r\n\r\n        </div><div class=\"a_module wah_clear_cookies\">\r\n\r\n            <div class=\"a_module_exe\">\r\n\r\n                <button type=\"button\" class=\"wah-action-button wahout wah-call-clear-cookies\">לנקות זכרון \"עוגיות\"</button>\r\n\r\n            </div>\r\n\r\n        </div><div class=\"a_module wah_greyscale\">\r\n\r\n            <div class=\"a_module_exe\">\r\n\r\n                <button type=\"button\" id=\"greyscale\" class=\"greyscale wah-action-button wahout wah-call-greyscale\" aria-label=\"גווני אפור\" title=\"גווני אפור\">גווני אפור</button>\r\n\r\n            </div>\r\n\r\n        </div><div class=\"a_module wah_invert\">\r\n\r\n            <div class=\"a_module_exe\">\r\n\r\n                <button type=\"button\" class=\"wah-action-button wahout wah-call-invert\" aria-label=\"הפוך צבעים\" title=\"הפוך צבעים\">הפוך צבעים</button>\r\n\r\n            </div>\r\n\r\n        </div><div class=\"a_module wah_remove_animations\">\r\n\r\n            <div class=\"a_module_exe\">\r\n\r\n                <button type=\"button\" class=\"wah-action-button wahout wah-call-remove-animations\" aria-label=\"הסרת אנימציות\" title=\"הסרת אנימציות\">הסרת אנימציות</button>\r\n\r\n            </div>\r\n\r\n        </div><div class=\"a_module wah_remove_styles\">\r\n\r\n            <div class=\"a_module_exe\">\r\n\r\n                <button type=\"button\" class=\"wah-action-button wahout wah-call-remove-styles\" aria-label=\"הסרת עיצוב\" title=\"הסרת עיצוב\">הסרת עיצוב</button>\r\n\r\n            </div>\r\n\r\n        </div>\t\t\t\r\n\t<button type=\"button\" title=\"לסגור\" class=\"wah-skip close-wah-sidebar\">\r\n\r\n\t\tסגור\r\n\t</button>\r\n\r\n\t\t\t</div>\r\n\t</div>\r\n\r\n\t\r\r\r\n\r\r\r\r\r\r\r\r\r\r\n    <style media=\"screen\">#access_container {font-family:Arial, Helvetica, sans-serif;}</style>\r\r\r\r\r\r\r\r\r\r\r\n\r\r\r\r\r\r\r\r\r\r\n\r\n\r\n\t\r\n\r\n\r\r\r\n\t<style media=\"screen\" type=\"text/css\">\r\r\r\r\n\t\tbody #wp_access_helper_container button.aicon_link {\r\r\r\r\n\t\t\t\r\r\r\n\t\t\t\ttop:550px !important;\r\r\r\r\n\t\t\t\r\r\r\n\t\t\t\r\r\r\n\t\t\t\r\r\r\n\t\t\t\tleft:0px !important;\r\r\r\r\n\t\t\t\r\r\r\n\t\t\t\r\r\r\n\t\t}\r\r\r\r\n\t</style>\r\r\r\r\n\r\r\r\n\r\r\r\r\r\r\r\r\r\r\n\r\r\r\r\r\r\r\r\r\r\n\r\n\t\r\n\t<div class=\"wah-free-credits\">\r\n\r\n\t\t<div class=\"wah-free-credits-inner\">\r\n\r\n\t\t\t<a href=\"https://accessibility-helper.co.il/\" target=\"_blank\" title=\"Accessibility by WP Accessibility Helper Team\">Accessibility by WAH</a>\r\n\r\n\t\t</div>\r\n\r\n\t</div>\r\n\r\n\t\t<!-- WP Accessibility Helper. Created by Alex Volkov. -->\r\n</div>\r\n\r\n\r\r\r\r\r\r\r\r\r\r\n    <nav class=\"wah-skiplinks-menu\">\r\r\r\r\r\r\r\r\r\r\r\n    <!-- WP Accessibility Helper - Skiplinks Menu -->\r\r\r\r\r\r\r\r\r\r\r\n    <div class=\"wah-skipper\"><ul>\n<li class=\"page_item page-item-575569\"><a href=\"https://www.geektime.co.il/geektime-ethics/\">הקוד האתי של גיקטיים</a></li>\n<li class=\"page_item page-item-562797\"><a href=\"https://www.geektime.co.il/%d7%91%d7%95%d7%90%d7%95-%d7%a0%d7%aa%d7%97%d7%99%d7%9c/\">בואו נתחיל!</a></li>\n<li class=\"page_item page-item-538967\"><a href=\"https://www.geektime.co.il/all-the-latest-new-about-deepseek-%d7%93%d7%99%d7%a4%d7%a1%d7%99%d7%a7-ai-company-and-llm/\">דיפסיק DeepSeek: כל החדשות על חברת ה-AI הסינית</a></li>\n<li class=\"page_item page-item-529280\"><a href=\"https://www.geektime.co.il/weekly/\">הניוזלטר של גיקטיים</a></li>\n<li class=\"page_item page-item-519477\"><a href=\"https://www.geektime.co.il/gta-6-gta-vi-everything-you-wanted-to-know/\">מתי יוצא GTA 6, טריילר וכל הפרטים על המשחק הכי מצופה של השנה</a></li>\n<li class=\"page_item page-item-506939\"><a href=\"https://www.geektime.co.il/qr-codes-are-bad-for-your-health/\">לא אמרנו שקוד QR זה מסוכן?</a></li>\n<li class=\"page_item page-item-42\"><a href=\"https://www.geektime.co.il/about/\">היי, אנחנו גיקטיים</