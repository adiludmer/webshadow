ss=\"modal-body container pt-5\">\r\n                    <div class=\"row position-relative\">\r\n                        <div class=\"col-12 mb-4\">\r\n\t                        <img src=\"https://cdn.geektime.co.il/wp-content/uploads/2024/09/geektime-logo-2.svg\" class=\"attachment-full size-full\" alt=\"geektime logo\" decoding=\"async\" loading=\"lazy\" />                        </div>\r\n                        <div class=\"col-12 mb-2\">\r\n                            <h2>אף אחד לא אוהב פרסומות</h2>\r\n                        </div>\r\n                        <div class=\"col-12 col-md-7 mx-auto mb-4 pb-3 entry\">\r\n\t                        <p><span style=\"font-weight: 400;\">בגלל זה אנחנו מקפידים שהן לא יציקו, אבל הן מאפשרות לנו לתת לכם תוכן בחינם. </span><span style=\"font-weight: 400;\"><br />\n</span><span style=\"font-weight: 400;\"><br />\n</span><span style=\"font-weight: 400;\">פרסומות עוזרות לנו להתקיים ולהתמקד במה שחשוב: ליצור עבורך תוכן מקצועי ומעניין. כדי להמשיך ליהנות מגיקטיים, כדאי להסיר את החסימה מהאתר שלנו. אנחנו מבטיחים לא להציף.</span></p>\n                        </div>\r\n                        <div class=\"col-12 mb-5\">\r\n\t                        <button type=\"button\" class=\"btn btn-green w-auto mx-auto mb-5\">\r\n                                הסרת חסימה מהירה                            </button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <script type=\"text/javascript\">\r\n        window._taboola = window._taboola || [];\r\n        _taboola.push({flush: true});\r\n    </script>\r\n\r\n    <script type=\"text/javascript\">window.NREUM||(NREUM={});NREUM.info={\"beacon\":\"bam.eu01.nr-data.net\",\"licenseKey\":\"NRJS-dc6b0e82c86178c5686\",\"applicationID\":\"399053182\",\"transactionName\":\"MhBSZQoZC0BYUBJZVwtacVIMEQpdFlUUX1YRWEBQHx0=\",\"queueTime\":0,\"applicationTime\":5406,\"atts\":\"HldRE0IDGE4=\",\"errorBeacon\"