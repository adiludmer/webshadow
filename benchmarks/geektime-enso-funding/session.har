            "text": "<article class=\"card card_you col-12 position-relative ev_card_you\"\r\n         tags=\"{{cats_ids}}\" post-id=\"{{post_id}}\"\r\n         data-financed=\"{{article_paid}}\" data-modify-date=\"{{last_modify}}\" data-title=\"{{title}}\" data-date=\"{{get_date}}\" data-author=\"{{author}}\" data-author-id=\"{{author_id}}\" data-cat=\"{{main_cat_name}}\"\r\n>\r\n    <div class=\"row\">\r\n        <div class=\"card_thumb col-auto\">\r\n            <a href=\"{{url}}\" class=\"d-block w-100\">\r\n                <img src=\"{{url_image_s}}\" class=\"attachment-card-mini size-card-mini wp-post-image ev-image\" alt=\"{{title}}\" loading=\"lazy\" width=\"83\" height=\"83\">\r\n                <div class=\"position-absolute top-0\">\r\n                    <div class=\"cat_in_favorites d-none\"></div>\r\n                </div>\r\n            </a>\r\n        </div>\r\n        <div class=\"col\">\r\n            <a href=\"{{url}}\" class=\"d-block w-100 ev-text\">\r\n                <div class=\"card_content d-block w-100\">\r\n                    <h5 class=\"card__title w-100\">{{title}}</h5>\r\n                </div>\r\n            </a>\r\n            <div class=\"card_meta d-block w-100\">\r\n                {{cats}}\r\n            </div>\r\n        </div>\r\n    </div>\r\n</article>\r\n"
