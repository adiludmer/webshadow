 \\u05ea\\u05d5\\u05d1\\u05d9\\u05dc \\u05d0\\u05d5\\u05ea\\u05e0\\u05d5 \\u05dc&quot;\\u05d0\\u05d5\\u05e7\\u05d9\\u05d9\\u05e0\\u05d5\\u05e1 \\u05e9\\u05dc \\u05d7\\u05d6\\u05e8\\u05ea\\u05d9\\u05d5\\u05ea&quot;.<\\/p>\\n<p>\\u05d1\\u05de\\u05d9\\u05d9\\u05dc \\u05e9\\u05e9\\u05dc\\u05d7, \\u05e8\\u05d5\\u05e1\\u05dc\\u05e0\\u05e1\\u05e7\\u05d9 \\u05e6\\u05d9\\u05d9\\u05df \\u05db\\u05d9 \\u05d4\\u05d4\\u05d7\\u05dc\\u05d8\\u05d4 \\u05d4\\u05e7\\u05e9\\u05d4 \\u05e0\\u05d1\\u05e2\\u05d4 \\u05de\\u05d0\\u05d9 \\u05e8\\u05e6\\u05d5\\u05e0\\u05d5 \\u05dc\\u05e2\\u05d1\\u05d5\\u05e8 \\u05dc\\u05de\\u05d8\\u05d4 \\u05d4\\u05d7\\u05d1\\u05e8\\u05d4 \\u05d1\\u05e8\\u05d3\\u05de\\u05d5\\u05e0\\u05d3 \\u05e9\\u05db\\u05df \\u05de\\u05e9\\u05e4\\u05d7\\u05ea\\u05d5 \\u05de\\u05ea\\u05d2\\u05d5\\u05e8\\u05e8\\u05ea \\u05d1\\u05d0\\u05d6\\u05d5\\u05e8 \\u05d4\\u05de\\u05e4\\u05e8\\u05e5.<\\/p>\\n\",\"date\":\"02\\/10\\/26<span class='d-inline ltr'> - <\\/span>9:04\",\"class\":\" exist-content\",\"link_share\":\"https:\\/\\/www.geektime.co.il\\/flash\\/ryan-roslansky-leaves-microsoft\\/\",\"data_d_m_y\":\"02\\/10\\/26\"},{\"num\":9,\"post_id\":592689,\"url\":\"https:\\/\\/www.geektime.co.il\\/flash#id-592689\",\"title\":\"\\u05d3\\u05d5\\u05d7 \\u05d7\\u05d3\\u05e9 \\u05e9\\u05dc \\u05de\\u05d9\\u05e7\\u05e8\\u05d5\\u05e1\\u05d5\\u05e4\\u05d8: \\u05d9\\u05e9\\u05e8\\u05d0\\u05dc \\u05d1\\u05de\\u05e7\\u05d5\\u05dd \\u05d4\\u05e9\\u05e0\\u05d9 \\u05d1\\u05ea\\u05e7\\u05d9\\u05e4\\u05d5\\u05ea \\u05e1\\u05d9\\u05d9\\u05d1\\u05e8\",\"excerpt\":\"<p>\\u05e2\\u05dc \\u05e4\\u05d9 \\u05d3\\u05d5\\u05d7 \\u05d4\\u05d4\\u05d2\\u05e0\\u05d4 \\u05d4\\u05d3\\u05d9\\u05d2\\u05d9\\u05d8\\u05dc\\u05d9\\u05ea \\u05d4\\u05e9\\u05e0\\u05ea\\u05d9 \\u05e9\\u05dc \\u05de\\u05d9\\u05e7\\u05e8\\u05d5\\u05e1\\u05d5\\u05e4\\u05d8, \\u05d9\\u05e9\\u05e8\\u05d0\\u05dc \\u05de\\u05d3\\u05d5\\u05e8\\u05d2\\u05ea \\u05d1\\u05de\\u05e7\\u05d5\\u05dd \\u05d4\\u05e9\\u05e0\\u05d9 \\u05d1\\u05e2\\u05d5\\u05dc\\u05dd \\u05d5\\u05d4\\u05e8\\u05d0\\u05e9\\u05d5\\u05df \\u05d1\\u05de\\u05d6\\u05e8\\u05d7 \\u05d4\\u05ea\\u05d9\\u05db\\u05d5\\u05df \\u05d1\\u05de\\u05d3\\u05d3 \\u05de\\u05ea\\u05e7\\u05e4\\u05d5\\u05ea \\u05d4\\u05e1\\u05d9\\u05d9\\u05d1\\u05e8 \\u05e0\\u05d2\\u05d3\\u05d4, \\u05e2\\u05dd 7.6% \\u05de\\u05db\\u05dc\\u05dc \\u05d4\\u05e4\\u05e2\\u05d9\\u05dc\\u05d5\\u05ea \\u05d4\\u05d2\\u05dc\\u05d5\\u05d1\\u05dc\\u05d9\\u05ea \\u05e9\\u05e0\\u05de\\u05d3\\u05d3\\u05d4. \\u05d0\\u05ea \\u05d9\\u05e9\\u05e8\\u05d0\\u05dc \\u05d4\\u05e7\\u05d3\\u05d9\\u05de\\u05d4 \\u05d1\\u05de\\u05d3\\u05d3 \\u05d4\\u05de\\u05e4\\u05d5\\u05e7\\u05e4\\u05e7 \\u05e8\\u05e7 \\u05d0\\u05e8\\u05e6\\u05d5\\u05ea \\u05d4\\u05d1\\u05e8\\u05d9\\u05ea.<\\/p>\\n<p>\\u05d4\\u05d3\\u05d5\\u05d7 \\u05de\\u05e6\\u05d9\\u05d9\\u05df \\u05e9\\u05d9\\u05e9\\u05e8\\u05d0\\u05dc \\u05d4\\u05d9\\u05d0 \\u05d4\\u05d9\\u05e2\\u05d3 \\u05d4\\u05de\\u05e8\\u05db\\u05d6\\u05d9 \\u05e9\\u05dc \\u05d0\\u05d9\\u05e8\\u05d0\\u05df, \\u05e9\\u05de\\u05db\\u05d5\\u05d5\\u05e0\\u05ea \\u05d0\\u05dc\\u05d9\\u05d4 39% \\u05de\\u05db\\u05dc\\u05dc \\u05e4\\u05e2\\u05d9\\u05dc\\u05d5\\u05ea \\u05d4\\u05e1\\u05d9\\u05d9\\u05d1\\u05e8 \\u05e9\\u05dc\\u05d4, \\u05dc\\u05e6\\u05d3 \\u05e2\\u05dc\\u05d9\\u05d9\\u05d4 \\u05e9\\u05dc 21% \\u05d1\\u05de\\u05ea\\u05e7\\u05e4\\u05d5\\u05ea \\u05d4\\u05db\\u05d5\\u05e4\\u05e8 \\u05e0\\u05d2\\u05d3\\u05d4. \\u05d4\\u05de\\u05d8\\u05e8\\u05d5\\u05ea \\u05d4\\u05d1\\u05d5\\u05dc\\u05d8\\u05d5\\u05ea \\u05e9\\u05dc \\u05d4\\u05ea\\u05e7\\u05d9\\u05e4\\u05d5\\u05ea \\u05de\\u05ea\\u05e4\\u05dc\\u05d2\\u05d5\\u05ea \\u05dc\\u05d0\\u05e7\\u05d3\\u05de\\u05d9\\u05d4 \\u05d5\\u05de\\u05d7\\u05e7\\u05e8 (28%), \\u05e2\\u05e0\\u05e3 \\u05d8\\u05db\\u05e0\\u05d5\\u05dc\\u05d5\\u05d2\\u05d9\\u05d5\\u05ea \\u05d4\\u05de\\u05d9\\u05d3\\u05e2 (12%), \\u05ea\\u05d7\\u05d1\\u05d5\\u05e8\\u05d4 (11%) \\u05d5\\u05d2\\u05d5\\u05e4\\u05d9\\u05dd \\u05de\\u05de\\u05e9\\u05dc\\u05ea\\u05d9\\u05d9\\u05dd (8%).<\\/p>\\n<p>\\u05dc\\u05e4\\u05d9 \\u05de\\u05d9\\u05e7\\u05e8\\u05d5\\u05e1\\u05d5\\u05e4\\u05d8, \\u05d4\\u05e4\\u05e2\\u05d9\\u05dc\\u05d5\\u05ea \\u05d4\\u05d0\\u05d9\\u05e8\\u05d0\\u05e0\\u05d9\\u05ea \\u05d4\\u05e4\\u05db\\u05d4 \\u05dc\\u05dc\\u05d5\\u05d7\\u05de\\u05d4 \\u05d4\\u05d9\\u05d1\\u05e8\\u05d9\\u05d3\\u05d9\\u05ea, \\u05e9\\u05dc\\u05e6\\u05d3 \\u05d9\\u05e2\\u05d3\\u05d9\\u05dd \\u05d2\\u05d9\\u05d0\\u05d5\\u05e4\\u05d5\\u05dc\\u05d9\\u05d8\\u05d9\\u05d9\\u05dd \\u05d2\\u05dd &quot;\\u05de\\u05e9\\u05dc\\u05d1\\u05ea \\u05e4\\u05e2\\u05d9\\u05dc\\u05d5\\u05ea \\u05e1\\u05d9\\u05d9\\u05d1\\u05e8, \\u05e4\\u05e2\\u05d9\\u05dc\\u05d5\\u05ea \\u05e6\\u05d1\\u05d0\\u05d9\\u05ea \\u05d5\\u05de\\u05d1\\u05e6\\u05e2\\u05d9 \\u05d4\\u05e9\\u05e4\\u05e2\\u05d4&quot; \\u05db\\u05d3\\u05d9 \\u05dc\\u05d4\\u05e2\\u05e6\\u05d9\\u05dd \\u05de\\u05e1\\u05e8\\u05d9\\u05dd \\u05d0\\u05e1\\u05d8\\u05e8\\u05d8\\u05d2\\u05d9\\u05d9\\u05dd. \\u05d1\\u05de\\u05d9\\u05e9\\u05d5\\u05e8 \\u05d4\\u05d8\\u05db\\u05e0\\u05d9, \\u05de\\u05e2\\u05dc 99% \\u05de\\u05e0\\u05d9\\u05e1\\u05d9\\u05d5\\u05e0\\u05d5\\u05ea \\u05d4\\u05d7\\u05d3\\u05d9\\u05e8\\u05d4 \\u05d4\\u05e8\\u05d0\\u05e9\\u05d5\\u05e0\\u05d9\\u05d9\\u05dd \\u05dc\\u05e2\\u05e0\\u05df \\u05d4\\u05ea\\u05d1\\u05e1\\u05e1\\u05d5 \\u05e2\\u05dc \\u05de\\u05ea\\u05e7\\u05e4\\u05d5\\u05ea Password Spray. \\u05d1\\u05e0\\u05d5\\u05e1\\u05e3, \\u05d1\\u05d7\\u05d1\\u05e8\\u05d4 \\u05de\\u05e1\\u05de\\u05e0\\u05d9\\u05dd \\u05d0\\u05ea \\u05e1\\u05d5\\u05db\\u05e0\\u05d9 \\u05d4-AI \\u05db\\u05de\\u05e9\\u05d8\\u05d7 \\u05ea\\u05e7\\u05d9\\u05e4\\u05d4 \\u05d7\\u05d3\\u05e9 \\u05d4\\u05de\\u05d7\\u05d9\\u05d9\\u05d1 \\u05d4\\u05d2\\u05e0\\u05d4 \\u05e8\\u05e6\\u05d9\\u05e4\\u05d4.<\\/p>\\n<div id=\\\"attachment_592692\\\" style=\\\"width: 939px\\\" class=\\\"wp-caption aligncenter\\\"><picture>\\n    <source srcset=\\\"https:\\/\\/cdn.geektime.co.il\\/wp-content\\/uploads\\/2026\\/10\\/ISRAEL-MAP.jpg.webp\