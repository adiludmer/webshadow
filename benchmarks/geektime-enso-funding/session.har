            "mimeType": "text/html",
            "size": 2147,
            "text": "<div class=\"swiper-slide slide-company bg-white equalHeight\">\r\n    <a href=\"{{url}}\" class=\"d-grid w-100 h-100\">\r\n        <div class=\"d-block w-100 slide-company_thumb position-relative overflow-hidden\">\r\n            <img src=\"{{url_image}}\" class=\"attachment-card-company size-card-company wp-post-image\" alt=\"{{title}}\" />\r\n        </div>\r\n        <div class=\"d-block w-100 slide-company_content position-relative p-3 pt-5 px-md-4\" style=\"min-height: 190px\">\r\n            <div class=\"card-company__logo bg-white bg-white-important position-absolute\">\r\n                <img src=\"{{url_logo}}\" class=\"swiper-lazy swiper-lazy-loaded\" alt=\"{{title}} LOGO\" loadingnull=\"nulllazy\">\r\n            </div>\r\n            <div class=\"middle w-100\">\r\n                <h3 class=\"card-company__title pt-1 mb-2 mb-0 fw-bold\">{{title}}</h3>\r\n                <div class=\"entry\">{{excerpt}}</div>\r\n            </div>\r\n        </div>\r\n        <div class=\"d-grid w-100 slide-company_bottom align-bottom align-items-end p-3 px-md-4 mt-auto mb-0\" style=\"min-height: 95px\">\r\n            <div class=\"d-block mt-auto mb-0\">\r\n                    <div class=\"card-company__meta d-flex flex-wrap aligncenter mt-3 mb-2\">\r\n                        {{tags}}\r\n                    </div>\r\n            </div>\r\n            <div class=\"d-block mt-auto mb-0 pb-2\">\r\n                <div class=\"card-company__details d-flex flex-wrap\">\r\n                    <div class=\"card-company__location me-4\">\r\n                        <img src=\"https://insider.geektime.co.il/wp-content/themes/geektime-insider/assets/images/icon-location-gray.svg\" class=\"gray\" />\r\n                        <img src=\"https://insider.geektime.co.il/wp-content/themes/geektime-insider/assets/images/icon-location-white.svg\" class=\"white\" />\r\n                        <span>{{city}}</span>\r\n                    </div>\r\n                    <div class=\"card-company__jobs d-flex align-items-center\">\r\n                        <span class=\"counter bg-azure me-1 text-center\">{{jobs}} </span><span>משרות</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </a>\r\n</div>\r\n"
          },
