          "content": {
            "mimeType": "text/html",
            "size": 1399,
            "text": "<div class=\"swiper-slide widget_company__wrapper\">\r\n    <article class=\"widget_company\">\r\n        <a href=\"{{url}}\" class=\"widget_company__box d-flex flex-column\r\n         bg-white h-100 position-relative\"\r\n           style=\"background-image: url({{url_image}});\"\r\n        >\r\n            <div class=\"widget-company__bottom p-3 px-md-4 align-bottom align-items-end w-100 mt-auto mb-0\">\r\n                <div class=\"row\">\r\n                    <div class=\"col-12\">\r\n                        <div class=\"widget_company__first pt-1 mb-3 mb-0 fw-bold\">\r\n                            <img src=\"{{logo_white}}\" alt=\"{{title}}\">\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"col-12\">\r\n                        <div class=\"widget_company__entry mb-3\">{{excerpt}}</div>\r\n                    </div>\r\n                    <div class=\"col-12 mb-4\">\r\n                        <button class=\"btn btn-green small\">לעמוד שלנו</button>\r\n                    </div>\r\n                    <div class=\"col-12 mt-1\">\r\n                        <img src=\"/wp-content/themes/geektime/assets/images/logo-insider.svg\"\r\n                             alt=\"Logo Geektime Insider\"\r\n                             class=\"mx-auto my-3 logo-insider\"\r\n                        />\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </a>\r\n    </article>\r\n</div>\r\n"
          },
