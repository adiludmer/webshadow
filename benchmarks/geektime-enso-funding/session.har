            "text": "{\"status\":\"succeeded\",\"posts\":[{\"num\":1,\"post_id\":592837,\"url\":\"https:\\/\\/www.geektime.co.il\\/flash#id-592837\",\"title\":\"\\u05d1\\u05d2\\u05dc\\u05dc \\u05d4\\u05e1\\u05d5\\u05db\\u05e0\\u05d9\\u05dd: \\u05d0\\u05e4\\u05dc \\u05de\\u05e7\\u05e9\\u05d9\\u05d7\\u05d4 \\u05d0\\u05ea \\u05d4\\u05d2\\u05d9\\u05e9\\u05d4 \\u05dc\\u05de\\u05e7\",\"excerpt\":\"<p>\\u05d0\\u05e4\\u05dc \\u05d4\\u05d5\\u05d3\\u05d9\\u05e2\\u05d4 \\u05db\\u05d9 \\u05ea\\u05d5\\u05e1\\u05d9\\u05e3 \\u05d1\\u05e7\\u05e8\\u05d5\\u05ea \\u05d7\\u05d3\\u05e9\\u05d5\\u05ea \\u05e1\\u05d1\\u05d9\\u05d1 \\u05d4\\u05d2\\u05d3\\u05e8\\u05ea Full Disk Access \\u05d1-macOS, \\u05d1\\u05d8\\u05e2\\u05e0\\u05d4 \\u05e9\\u05e1\\u05d5\\u05db\\u05e0\\u05d9 AI \\u05d4\\u05d2\\u05d3\\u05d9\\u05dc\\u05d5 \\u05de\\u05e9\\u05de\\u05e2\\u05d5\\u05ea\\u05d9\\u05ea \\u05d0\\u05ea \\u05d4\\u05e1\\u05d9\\u05db\\u05d5\\u05e0\\u05d9\\u05dd \\u05e9\\u05de\\u05d2\\u05d9\\u05e2\\u05d9\\u05dd \\u05e2\\u05dd \\u05de\\u05ea\\u05df \\u05d2\\u05d9\\u05e9\\u05d4 \\u05db\\u05d6\\u05d0\\u05ea. \\u05d4\\u05d4\\u05d2\\u05d3\\u05e8\\u05d4 \\u05de\\u05d0\\u05e4\\u05e9\\u05e8\\u05ea \\u05dc\\u05d0\\u05e4\\u05dc\\u05d9\\u05e7\\u05e6\\u05d9\\u05d5\\u05ea \\u05dc\\u05d2\\u05e9\\u05ea \\u05dc\\u05e7\\u05d1\\u05e6\\u05d9\\u05dd, \\u05d3\\u05d5\\u05d0\\u05e8, \\u05d4\\u05d5\\u05d3\\u05e2\\u05d5\\u05ea \\u05d5\\u05d4\\u05d9\\u05e1\\u05d8\\u05d5\\u05e8\\u05d9\\u05d9\\u05ea \\u05d2\\u05dc\\u05d9\\u05e9\\u05d4. \\u05d4\\u05d4\\u05db\\u05e8\\u05d6\\u05d4 \\u05d4\\u05d2\\u05d9\\u05e2\\u05d4 \\u05d9\\u05de\\u05d9\\u05dd \\u05d0\\u05d7\\u05e8\\u05d9 \\u05e9\\u05e2\\u05d9\\u05ea\\u05d5\\u05e0\\u05d0\\u05d9 \\u05d8\\u05e2\\u05df \\u05e9\\u05d0\\u05e4\\u05dc\\u05d9\\u05e7\\u05e6\\u05d9\\u05d9\\u05ea Muse \\u05e9\\u05dc \\u05de\\u05d8\\u05d0 \\u05e7\\u05e8\\u05d0\\u05d4 \\u05d0\\u05ea \\u05d4\\u05d4\\u05d5\\u05d3\\u05e2\\u05d5\\u05ea \\u05d4\\u05e4\\u05e8\\u05d8\\u05d9\\u05d5\\u05ea \\u05e9\\u05dc\\u05d5 \\u05dc\\u0